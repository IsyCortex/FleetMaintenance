# Copy this file to .env and adjust as needed for your machine.

# The port the web application listens on.
PORT=3000

# Where the application connects to PostgreSQL.
# Defaults in src/config.js match this local dev setup (see docker-compose.yml).
DATABASE_URL=postgres://fleet:fleet@localhost:5432/fleetmaintenance

# Which AI provider the application uses to analyze defect reports.
# "fake" = deterministic local analyzer (no network, no key).
# "local" = locally hosted LLM via Ollama on the LAN (see LOCAL_LLM_* below).
AI_PROVIDER=fake

# --- Local LLM (Ollama) settings, used only when AI_PROVIDER=local ---
# Fill in your desktop's LAN address. Keep the real value in .env, not here.
LOCAL_LLM_URL=http://<desktop-lan-ip>:11434
LOCAL_LLM_MODEL=qwen3:30b-a3b
# 0 = no timeout (allows long local inference). Set a generous ceiling only if needed.
LOCAL_LLM_TIMEOUT_MS=0
